# Include these directives inside the existing http {} block.
map $http_cookie $mtls_session {
    default "";
    "~(?:^|;\s*)__Host-certportal=([^;]+)" "__Host-certportal=$1";
}
map $http_cookie $mtls_login {
    default "";
    "~(?:^|;\s*)__Host-certportal-login=([^;]+)" "__Host-certportal-login=$1";
}
# $uri deliberately excludes OIDC code/state query parameters.
log_format mtls_portal '$remote_addr $request_method $uri $status';

server {
    listen 443 ssl;
    server_name certs.example.com;
    ssl_certificate /path/to/fullchain.pem;
    ssl_certificate_key /path/to/key.pem;
    access_log /var/log/nginx/mtls-portal.log mtls_portal;
    client_max_body_size 16k;
    client_body_timeout 15s;
    location / {
        proxy_pass http://127.0.0.1:3095;
        proxy_http_version 1.1;
        proxy_set_header Host certs.example.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Cookie "$mtls_session; $mtls_login";
        proxy_set_header Connection "";
        proxy_read_timeout 65s;
        proxy_buffering off;
    }
}
